<Window x:Class="FairPlay.Shell.ExitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Invigilator exit" Height="320" Width="460"
        WindowStartupLocation="CenterOwner" WindowStyle="ToolWindow"
        ResizeMode="NoResize" Topmost="True" Background="#1B2533">
    <StackPanel Margin="28">
        <TextBlock x:Name="Heading" Foreground="White" FontSize="18" FontWeight="SemiBold"
                   Text="Invigilator exit" Margin="0,0,0,10" />
        <TextBlock x:Name="Body" Foreground="#C9D2DE" FontSize="13" TextWrapping="Wrap"
                   Margin="0,0,0,14" />
        <PasswordBox x:Name="CodeBox" FontSize="16" Padding="8,6" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="OfflineButton" Content="Offline code…" Padding="12,6" Margin="0,0,10,0"
                    Click="Offline_Click" />
            <Button Content="End locked mode" Padding="14,6" Margin="0,0,10,0" IsDefault="True"
                    Click="Ok_Click" />
            <Button Content="Cancel" Padding="14,6" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
